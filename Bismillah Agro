<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Bismillah Agro</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;background:#e9ece9;font-family:Arial,sans-serif;color:#222}
.app{width:100%;max-width:520px;min-height:100vh;margin:auto;background:#f7f7f7;box-shadow:0 0 18px #0002;position:relative;padding-bottom:70px}
.top{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #ddd}
.bar{display:flex;align-items:center;gap:9px;padding:10px}
.logo{font-size:18px;font-weight:800;color:#18833d;white-space:nowrap;cursor:pointer}
.search{min-width:0;flex:1;background:#f1f3f2;border:1px solid #e1e5e2;border-radius:11px;padding:10px 12px;font-size:14px;min-height:42px}
.cartTop{border:0;background:#e8f5ed;color:#14753a;font-size:18px;padding:7px 12px;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:4px;font-weight:bold}
.hero{padding:10px}
.banner{border-radius:13px;padding:20px 16px;background:linear-gradient(120deg,#dff5e6,#fff)}
.banner h1{margin:0 0 5px;font-size:24px;color:#18833d}
.banner p{margin:0;color:#5e675f;font-size:13px}
.cats{display:flex;gap:8px;overflow:auto;padding:2px 10px 12px}
.cat{border:0;background:#fff;padding:8px 14px;border-radius:20px;white-space:nowrap;cursor:pointer;font-size:13px}
.cat.active{background:#198754;color:#fff;font-weight:bold}
.sectionTitle{padding:7px 11px;display:flex;justify-content:space-between;align-items:center}
.sectionTitle h2{font-size:18px;margin:4px 0}
.count{font-size:12px;color:#777}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;padding:0 9px 20px}
.card{background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 1px 5px #0001;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between}
.pic{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;background:#edf0ed}
.noimg{display:flex;align-items:center;justify-content:center;color:#999;font-size:12px;background:#e2e5e2;aspect-ratio:1/1}
.info{padding:9px;display:flex;flex-direction:column;flex:1;justify-content:space-between}
.name{font-size:14px;font-weight:700;margin-bottom:2px}
.meta{font-size:11px;color:#777;margin-bottom:8px}
.row{display:flex;align-items:center;justify-content:space-between;gap:4px;margin-bottom:6px}
.price{font-weight:800;font-size:15px;color:#18833d}
.mini{border:0;background:#e8f5ed;color:#14753a;border-radius:7px;padding:6px 9px;font-weight:700;font-size:12px;cursor:pointer}
.buy{border:0;background:#198754;color:#fff;padding:8px;border-radius:7px;font-weight:700;cursor:pointer;width:100%;font-size:13px}

/* Details Page */
.detail{display:none;padding-bottom:20px}
.detailHead{display:flex;align-items:center;background:#fff;padding:10px;position:sticky;top:0;z-index:15;border-bottom:1px solid #ddd}
.back{border:0;background:#fff;font-size:22px;cursor:pointer;padding:0 8px}
.detailHead b{margin-left:8px;font-size:16px}
.detailImg{width:100%;aspect-ratio:1/1;background:#eef1ee;object-fit:cover}
.detailInfo{background:#fff;padding:15px}
.detailInfo h1{font-size:22px;margin:0 0 7px}
.dmeta{color:#707770;font-size:13px}
.dprice{font-size:24px;font-weight:800;margin:12px 0;color:#18833d}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.add{border:0;padding:13px;border-radius:9px;font-weight:800;background:#e8f5ed;color:#14753a;cursor:pointer}
.more{padding:10px}
.more h3{font-size:17px;margin-top:15px}
.moreGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}

/* Cart Page */
.cartSection{display:none;padding:12px}
.cartHead{display:flex;align-items:center;justify-content:space-between;background:#fff;padding:12px;border-radius:10px;margin-bottom:12px;border:1px solid #ddd}
.cartHead h2{margin:0;font-size:18px}
.cartItemCard{display:flex;align-items:center;gap:10px;background:#fff;padding:10px;border-radius:10px;margin-bottom:8px;box-shadow:0 1px 4px #0001;position:relative}
.cartItemImg{width:60px;height:60px;border-radius:8px;object-fit:cover}
.cartItemDetails{flex:1}
.cartItemTitle{font-weight:bold;font-size:14px}
.cartItemMeta{font-size:12px;color:#666;margin:2px 0 6px}
.cartQtyRow{display:flex;align-items:center;gap:8px}
.qtyBtn{border:0;background:#eee;width:26px;height:26px;border-radius:6px;font-weight:bold;font-size:16px;cursor:pointer}
.qtyVal{font-weight:bold;font-size:14px}
.cartItemSubtotal{margin-left:auto;font-weight:bold;color:#18833d;font-size:14px}
.removeBtn{border:0;background:transparent;color:#d9534f;font-size:18px;cursor:pointer;padding:4px}
.cartSummary{background:#fff;padding:14px;border-radius:10px;margin-top:14px;border:1px solid #ddd}
.cartSummaryRow{display:flex;justify-content:space-between;margin-bottom:8px;font-size:15px;font-weight:bold}
.clearBtn{background:#f8d7da;color:#842029;border:0;padding:8px 12px;border-radius:8px;font-weight:bold;cursor:pointer;width:100%;margin-top:8px}

/* Bottom Nav */
.bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100%);background:#fff;border-top:1px solid #ddd;display:flex;justify-content:space-around;z-index:30;padding:6px 2px}
.bottom button{border:0;background:#fff;font-size:12px;font-weight:600;padding:4px 10px;min-width:65px;cursor:pointer;color:#444}
.bottom b{display:block;font-size:20px;margin-bottom:2px}
.bottom button.active{color:#18833d}

/* File Upload Button Styling */
.fileUploadContainer{display:flex;align-items:center;gap:10px;margin-top:6px}
.customFileBtn{background:#e8f5ed;color:#14753a;border:1px solid #14753a;padding:9px 15px;border-radius:8px;font-weight:bold;font-size:13px;cursor:pointer;display:inline-block;transition:0.2s}
.customFileBtn:hover{background:#14753a;color:#fff}
.fileNameText{font-size:12px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}

/* Modals */
.admin,.orderModal{display:none;position:fixed;inset:0;background:#0008;z-index:50;align-items:center;justify-content:center;padding:14px}
.panel,.orderBox{width:min(430px,94%);max-height:90vh;overflow:auto;background:#fff;border-radius:16px;padding:17px;position:relative}
.close{float:right;border:0;background:#eee;border-radius:50%;width:30px;height:30px;font-weight:bold;cursor:pointer}
.panel label,.orderBox label{display:block;font-size:12px;font-weight:bold;margin:10px 0 4px}
.panel input[type="text"],.panel input[type="number"],.panel input[type="password"],.panel select,.orderBox input,.orderBox textarea{width:100%;padding:10px;border:1px solid #ccd3ce;border-radius:8px;font-size:14px}
.preview{display:none;width:100%;aspect-ratio:1.4;object-fit:contain;background:#f1f2f1;border-radius:8px;margin-top:10px}
.green,.placeBtn{width:100%;border:0;background:#198754;color:white;padding:12px;border-radius:8px;margin-top:13px;font-weight:800;cursor:pointer;font-size:15px}
.closeOrder{width:100%;border:0;background:#eee;padding:11px;border-radius:9px;margin-top:8px;font-weight:700;cursor:pointer}
.toast{position:fixed;bottom:75px;left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:10px 18px;border-radius:20px;display:none;z-index:60;font-size:13px;box-shadow:0 2px 8px #0004}
.badge{background:#d9534f;color:#fff;font-size:11px;border-radius:10px;padding:2px 6px;margin-left:2px}
</style>
</head>
<body>
<div class="app">
<header class="top">
  <div class="bar">
    <div class="logo" onclick="goHome()">Bismillah Agro</div>
    <input id="search" class="search" placeholder="Search products..." oninput="renderHome()">
    <button class="cartTop" onclick="showCart()">🛒 <span class="badge cartBadge">0</span></button>
  </div>
</header>

<!-- HOME SECTION -->
<section id="home">
  <div class="hero"><div class="banner"><h1>Fresh Products</h1><p>Pure &amp; quality groceries from Sonitpur, Assam.</p></div></div>
  <div class="cats" id="cats"></div>
  <div class="sectionTitle"><h2>Products</h2><span class="count" id="count"></span></div>
  <div class="grid" id="grid"></div>
</section>

<!-- PRODUCT DETAIL SECTION -->
<section id="detail" class="detail">
  <div class="detailHead"><button class="back" onclick="goHome()">‹</button><b>Product Details</b></div>
  <div id="detailBody"></div>
</section>

<!-- CART SECTION -->
<section id="cartSection" class="cartSection">
  <div class="cartHead">
    <h2>Shopping Cart 🛒</h2>
    <button class="mini" onclick="goHome()">+ Add More</button>
  </div>
  <div id="cartItems"></div>
  <div class="cartSummary" id="cartSummary">
    <div class="cartSummaryRow"><span>Total Price:</span><span id="cartTotal">₹0</span></div>
    <button class="buy" id="checkoutBtn" onclick="checkoutCart()" style="padding:12px;font-size:15px">Proceed to Order</button>
    <button class="clearBtn" onclick="clearCart()">Clear Cart</button>
  </div>
</section>

<!-- BOTTOM NAV -->
<nav class="bottom">
  <button id="navHome" class="active" onclick="goHome()"><b>🏠</b>Home</button>
  <button id="navCart" onclick="showCart()"><b>🛒</b>Cart <span class="badge cartBadge">0</span></button>
  <button id="navAdmin" onclick="openAdmin()"><b>🔑</b>Admin</button>
</nav>

</div>

<div id="toast" class="toast"></div>

<!-- ORDER MODAL -->
<div class="orderModal" id="orderModal">
<div class="orderBox">
<h2>Place Your Order</h2>
<div id="orderSummary" style="background:#f1f5f1;padding:11px;border-radius:9px;margin-bottom:10px;font-size:13px"></div>
<form id="orderForm">
<input type="hidden" id="orderProduct"><input type="hidden" id="orderWeight"><input type="hidden" id="orderPrice">
<label>Your Name</label><input id="customerName" required placeholder="Enter your name">
<label>Mobile Number</label><input id="customerMobile" required inputmode="tel" placeholder="Enter mobile number">
<label>Full Address</label><textarea id="customerAddress" required placeholder="House/Village, Post Office, District, State"></textarea>
<label>PIN Code</label><input id="customerPin" required inputmode="numeric" maxlength="6" placeholder="6 digit PIN">
<button class="placeBtn" type="submit">Confirm &amp; Place Order</button>
<button class="closeOrder" type="button" onclick="closeOrder()">Cancel</button>
</form></div></div>

<!-- ADMIN MODAL -->
<div id="admin" class="admin">
  <div class="panel">
    <button class="close" onclick="closeAdmin()">✕</button>
    <div id="login">
      <h3>Admin Login</h3>
      <label>Password</label>
      <input type="password" id="password" placeholder="Enter admin password">
      <button class="green" onclick="login()">Login</button>
    </div>
    <div id="form" style="display:none">
      <h3>Add New Product</h3>
      <label>Product Title</label>
      <input type="text" id="pname" placeholder="e.g. Chili Powder">
      <label>Category</label>
      <select id="pcat">
        <option value="Spices">Spices</option>
        <option value="Vegetables">Vegetables</option>
        <option value="Oils">Oils</option>
        <option value="Grains">Grains</option>
        <option value="Other">Other</option>
      </select>
      <label>Weight / Quantity</label>
      <input type="text" id="pweight" placeholder="e.g. 100 gram / 1 kg">
      <label>Price (₹)</label>
      <input type="number" id="pprice" placeholder="e.g. 50">
      
      <label>Product Image</label>
      <div class="fileUploadContainer">
        <label for="pfile" class="customFileBtn">📁 Choose a file</label>
        <input type="file" id="pfile" accept="image/*" onchange="pick(event)" style="display:none">
        <span id="fileName" class="fileNameText">No file chosen</span>
      </div>
      <img id="preview" class="preview">
      
      <button class="green" onclick="addProduct()">Publish Product</button>
    </div>
  </div>
</div>

<script>
const PASS="9085552172";
const SHEET_API="https://script.google.com/macros/s/AKfycbyNmsmToYpJkpYWAmeO-8wtq76LQZ8Lt8Lm0vNCvYzvJowwTJM4AkYHJ6EkdApTyMX0/exec";
let sheetProducts=[];
let sheetLoaded=false;

const DEFAULT=[
{title:"Chili Powder",category:"Spices",weight:"100 gram",price:"40",img:""},
{title:"Turmeric Powder",category:"Spices",weight:"100 gram",price:"30",img:""},
{title:"Cumin Powder",category:"Spices",weight:"100 gram",price:"30",img:""},
{title:"Ginger",category:"Vegetables",weight:"1 poa",price:"40",img:""},
{title:"Garlic",category:"Vegetables",weight:"1 poa",price:"60",img:""},
{title:"Onion",category:"Vegetables",weight:"1 kg",price:"70",img:""}];

let category="All", selectedImage="", cart=JSON.parse(localStorage.getItem("agb_cart")||"[]");

function products(){
  const local=JSON.parse(localStorage.getItem("agb_products")||"null");
  return sheetLoaded ? sheetProducts : (local || DEFAULT);
}

async function loadProducts(){
  try{
    const r=await fetch(SHEET_API,{cache:"no-store"});
    const d=await r.json();
    if(Array.isArray(d) && d.length>0){
      sheetProducts=d.filter(x=>x.title).map(x=>({
        id:x.id,title:x.title,category:x.category||"Other",
        weight:x.weight||"",price:String(x.price||""),
        img:x.img||""
      }));
      sheetLoaded=true;
      localStorage.setItem("agb_products",JSON.stringify(sheetProducts));
      renderHome();
    }
  }catch(e){ console.log("Sheet load failed",e); }
}

function esc(x){return String(x??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function img(p,cls="pic"){return p.img?`<img class="${cls}" src="${p.img}" alt="${esc(p.title)}">`:`<div class="${cls} noimg">No Image</div>`}

function renderCats(){
  let cats=["All",...new Set(products().map(p=>p.category))];
  document.getElementById("cats").innerHTML=cats.map(c=>`<button class="cat ${c==category?'active':''}" onclick="category='${esc(c)}';renderHome()">${esc(c)}</button>`).join("");
}

function renderHome(){
  document.getElementById("home").style.display="block";
  document.getElementById("detail").style.display="none";
  document.getElementById("cartSection").style.display="none";
  setNavActive("navHome");
  renderCats();
  
  let q=document.getElementById("search").value.toLowerCase();
  let a=products().filter(p=>(category=="All"||p.category==category)&&p.title.toLowerCase().includes(q));
  document.getElementById("count").textContent=a.length+" items";
  
  document.getElementById("grid").innerHTML=a.map((p,i)=>{
    let idx=products().indexOf(p);
    return `<article class="card" onclick="openProduct(${idx})">
      ${img(p)}
      <div class="info">
        <div>
          <div class="name">${esc(p.title)}</div>
          <div class="meta">${esc(p.weight)} • ${esc(p.category)}</div>
        </div>
        <div>
          <div class="row">
            <span class="price">₹${esc(p.price)}</span>
            <button class="mini" onclick="event.stopPropagation();addCart(${idx})">+ Cart</button>
          </div>
          <button class="buy" onclick="event.stopPropagation();order(${idx})">Order Now</button>
        </div>
      </div>
    </article>`;
  }).join("");
  updateCartBadge();
}

function openProduct(i){
  let p=products()[i];
  document.getElementById("home").style.display="none";
  document.getElementById("detail").style.display="block";
  document.getElementById("cartSection").style.display="none";
  let related=products().filter((x,j)=>j!=i&&x.category==p.category);
  
  document.getElementById("detailBody").innerHTML=`
    ${img(p,"detailImg")}
    <div class="detailInfo">
      <h1>${esc(p.title)}</h1>
      <div class="dmeta">${esc(p.category)} • ${esc(p.weight)}</div>
      <div class="dprice">₹${esc(p.price)}</div>
      <div class="actions">
        <button class="add" onclick="addCart(${i})">🛒 Add to Cart</button>
        <button class="buy" onclick="order(${i})">Order Now</button>
      </div>
    </div>
    <div class="more">
      <h3>More from ${esc(p.category)}</h3>
      <div class="moreGrid">${related.map(x=>`
        <article class="card" onclick="openProduct(${products().indexOf(x)})">
          ${img(x)}
          <div class="info">
            <div class="name">${esc(x.title)}</div>
            <div class="meta">${esc(x.weight)}</div>
            <div class="price">₹${esc(x.price)}</div>
            <button class="buy" style="margin-top:8px" onclick="event.stopPropagation();order(${products().indexOf(x)})">Order Now</button>
          </div>
        </article>`).join("")||"<p>No more products in this category.</p>"}
      </div>
    </div>`;
  window.scrollTo(0,0);
}

function goHome(){renderHome();window.scrollTo(0,0)}

/* CART LOGIC */
function saveCart(){
  localStorage.setItem("agb_cart",JSON.stringify(cart));
  updateCartBadge();
}

